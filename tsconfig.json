{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "jest", "@playwright/test"]
  },
  "include": [
    "plugin/tagcore/assets/src/**/*.ts",
    "plugin/tagcore/assets/src/**/*.tsx",
    "tests/js/**/*.ts",
    "tests/e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
